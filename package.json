{
  "name": "conventional-comments-vscode",
  "displayName": "Conventional Comments for PR Reviews",
  "description": "Label PR review comments with Conventional Comments (praise, nitpick, issue…) as plain text or colored badges.",
  "version": "1.0.0",
  "publisher": "jbrulmans",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1E293B",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbrulmans/conventional-comments-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/jbrulmans/conventional-comments-vscode/issues"
  },
  "homepage": "https://github.com/jbrulmans/conventional-comments-vscode#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "conventional comments",
    "code review",
    "pull request",
    "pr review",
    "review comments",
    "github",
    "gitlab",
    "labels",
    "badges",
    "nitpick",
    "feedback"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "conventionalComments.insertLabel",
        "title": "Add Label",
        "category": "Conventional Comments",
        "icon": "$(add)"
      },
      {
        "command": "conventionalComments.toggleFormat",
        "title": "Toggle Badge / Plain Text",
        "category": "Conventional Comments"
      },
      {
        "command": "conventionalComments.removeLabel",
        "title": "Remove Label",
        "category": "Conventional Comments"
      },
      {
        "command": "conventionalComments.configureKeybinding",
        "title": "Change Keyboard Shortcut",
        "category": "Conventional Comments"
      },
      {
        "command": "conventionalComments.header.badge",
        "title": "Badge format (click for plain text)",
        "icon": "$(tag)"
      },
      {
        "command": "conventionalComments.header.plain",
        "title": "Plain text format (click for badge)",
        "icon": "$(symbol-text)"
      }
    ],
    "menus": {
      "comments/commentThread/title": [
        {
          "command": "conventionalComments.insertLabel",
          "group": "navigation@0",
          "when": "config.conventionalComments.showHeaderButtons"
        },
        {
          "command": "conventionalComments.header.badge",
          "group": "navigation@1",
          "when": "config.conventionalComments.showHeaderButtons && conventionalComments.format == 'badge'"
        },
        {
          "command": "conventionalComments.header.plain",
          "group": "navigation@1",
          "when": "config.conventionalComments.showHeaderButtons && conventionalComments.format == 'plain'"
        }
      ],
      "commandPalette": [
        {
          "command": "conventionalComments.header.badge",
          "when": "false"
        },
        {
          "command": "conventionalComments.header.plain",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "conventionalComments.insertLabel",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "commentEditorFocused"
      }
    ],
    "configuration": {
      "title": "Conventional Comments",
      "properties": {
        "conventionalComments.defaultFormat": {
          "type": "string",
          "enum": [
            "badge",
            "plain"
          ],
          "enumDescriptions": [
            "A shields.io badge, rendered as a colored image on GitHub/GitLab.",
            "The plain spec prefix, e.g. `suggestion (non-blocking):`."
          ],
          "default": "badge",
          "markdownDescription": "How new labels are written. Existing labels keep their format."
        },
        "conventionalComments.showHeaderButtons": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the **Add Label** (+) and badge/plain text toggle buttons in the header of PR review comment threads."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && npm run bundle -- --minify",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "compile": "npm run check-types && npm run bundle -- --sourcemap",
    "check-types": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"out/test/*.test.js\"",
    "package": "vsce package",
    "test:integration": "npm run compile && tsc -p tsconfig.json --outDir out && vscode-test",
    "publish:vsce": "vsce publish --packagePath *.vsix",
    "publish:ovsx": "ovsx publish *.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "ovsx": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
